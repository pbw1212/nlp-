# The product CLI requires a remote provider and never silently falls back to a local mock.
MEMORY_PROVIDER_MODE=REQUIRED

# CLI output mode. Development defaults to detailed telemetry; switch to USER
# for the end-user presentation after the product behavior is finalized.
AGENT_OUTPUT_MODE=DEVELOPER

# Runtime data path. Tests and demo use isolated temporary databases instead.
MEMORY_DB_PATH=memory_store.db

# Time-based forgetting is deliberately OFF by default. When enabled, the
# legacy decay/recycle maintenance path becomes available.
MEMORY_ENABLE_FORGETTING=false
# Optional provider-backed candidate reranking; OFF by default until evaluated.
MEMORY_ENABLE_MODEL_RERANK=false

# Ordinary turns do not use a hidden threshold/time worker. The Agent may call
# the registered update_long_term_memory tool, which evaluates that turn
# synchronously through the Provider-owned lifecycle boundary.

# Required for the product CLI. Never commit a real key.
# `.env.local` is ignored local-only configuration under ~/.agent_data/config.
# Process environment wins. Set MEMORY_LOAD_LOCAL_ENV=0 in CI/deterministic
# test commands to ignore the local file.
# The production runtime is deliberately fixed to DeepSeek V4 Flash.
DEEPSEEK_API_KEY=
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY_SECONDS=1
LLM_REQUEST_INTERVAL_SECONDS=0
# Optional DeepSeek reasoning effort: low / high / max. Thinking is enabled by default.
LLM_REASONING_EFFORT=
DEEPSEEK_MAX_TOKENS=
# DeepSeek V4 Flash has a documented 1M-token context window. This value is
# optional and can be used for a local lower budget during testing.
LLM_CONTEXT_WINDOW_TOKENS=
# Dynamic transcript compaction reserves room for system prompt, tools and output.
CONTEXT_RESERVE_TOKENS=8192
CONTEXT_COMPACTION_RATIO=0.78
CONTEXT_KEEP_RECENT_TOKENS=20000
PROVENANCE_EXCERPT_MAX_CHARS=240
